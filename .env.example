# Local development values only. Copy to .env with 06-CREATE-LOCAL-ENV.cmd (or `cp .env.example .env`).
# Never commit .env. Production values are supplied by the deployment environment;
# the API and worker refuse to start in production with any "local-only" placeholder below.
NODE_ENV=development

# Docker Compose dev PostgreSQL (bound to 127.0.0.1)
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=local-only-postgres-password
POSTGRES_DB=boardgame
POSTGRES_PORT=5434
DATABASE_URL=postgres://boardgame:local-only-postgres-password@127.0.0.1:5434/boardgame
# Used by `pnpm test`; database is created by docker/postgres-init on first start.
TEST_DATABASE_URL=postgres://boardgame:local-only-postgres-password@127.0.0.1:5434/boardgame_test

# API
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated browser origins allowed for CSRF origin checks and Socket.IO.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# >= 32 chars. HMAC key for OTP codes. Use a random value in any shared environment.
OTP_HASH_SECRET=local-only-otp-hash-secret-change-me-0000
# fixture = development-only delivery: accepts OTP_FIXTURE_CODE and never sends SMS (refused in production).
# kavenegar = real SMS via Kavenegar Verify Lookup; needs the API key and an approved template (server-side only).
OTP_PROVIDER=fixture
OTP_FIXTURE_CODE=123456
# KAVENEGAR_API_KEY=<from the Kavenegar panel; never commit>
# KAVENEGAR_VERIFY_TEMPLATE=<approved template name, e.g. verify>

LOG_LEVEL=info
# Turn-based tables a player may have at once (premium gets a higher, still finite, cap).
TURN_TABLE_LIMIT=10
TURN_TABLE_LIMIT_PREMIUM=30
# Payments: none = checkout disabled; fake = development-only gateway that moves no money (refused in production);
# zarinpal = Zarinpal REST v4. Use ZARINPAL_SANDBOX=true with a sandbox merchant id for testing (refused in production).
PAYMENT_PROVIDER=fake
# ZARINPAL_MERCHANT_ID=<36-character merchant id; never commit>
# ZARINPAL_SANDBOX=true
# Public web URL used for payment redirects and gateway return URLs.
PUBLIC_WEB_URL=http://localhost:5173

# Worker
WORKER_INTERVAL_SECONDS=60
