{
  "name": "persian-boardgame-webapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:services": "docker compose up -d postgres",
    "dev:api": "pnpm --filter @bg/api dev",
    "dev:web": "pnpm --filter @bg/web dev",
    "dev:worker": "pnpm --filter @bg/worker dev",
    "db:generate": "pnpm --filter @bg/db generate",
    "db:migrate": "pnpm --filter @bg/db migrate",
    "db:seed": "pnpm --filter @bg/db seed",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
