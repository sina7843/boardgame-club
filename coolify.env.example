# Coolify environment for compose.coolify.yaml (low-traffic TEST server). Placeholders only — never commit real values.
# Enter these in Coolify → resource → Environment Variables; mark passwords/secrets as secret.

POSTGRES_USER=boardgame
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=boardgame

# Internal service name `postgres`; password must match POSTGRES_PASSWORD (URL-encode special characters).
DATABASE_URL=postgres://boardgame:CHANGE_ME@postgres:5432/boardgame

# Public https origin of the web service — no :8080, no trailing slash.
WEB_ORIGINS=https://YOUR_DOMAIN
PUBLIC_WEB_URL=https://YOUR_DOMAIN

# >= 32 random characters.
OTP_HASH_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
# Test server: fixture OTP (no SMS). Private 6-digit code; 123456 / 000000 / 111111 are refused.
OTP_PROVIDER=fixture
OTP_FIXTURE_CODE=CHANGE_ME_PRIVATE_6_DIGIT_CODE
ALLOW_TEST_PROVIDERS=true

PAYMENT_PROVIDER=none

# Coolify/Traefik -> Caddy -> API = 2 proxy hops.
TRUST_PROXY_HOPS=2
LOG_LEVEL=info
WORKER_INTERVAL_SECONDS=60

# Optional (not needed for the test server):
# OTP_REQUESTS_PER_IP_PER_10_MIN=10
# TURN_TABLE_LIMIT=10
# TURN_TABLE_LIMIT_PREMIUM=30
# OTP_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_VERIFY_TEMPLATE=
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=false
# METRICS_TOKEN=
